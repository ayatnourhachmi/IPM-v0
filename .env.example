# === LLM Provider ===
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1

# Groq (optional legacy provider — set LLM_PROVIDER=groq)
# GROQ_API_KEY=gsk_your_groq_api_key_here

# Azure OpenAI (v1 migration — uncomment and set LLM_PROVIDER=azure)
# AZURE_OPENAI_API_KEY=your_azure_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# === Embedding Provider ===
EMBEDDING_PROVIDER=local
# OPENAI_API_KEY is also used if EMBEDDING_PROVIDER=openai

# === Langfuse ===
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# === Database ===
DATABASE_URL=postgresql+asyncpg://ipm:ipm@postgres:5432/ipm

# === ChromaDB ===
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# === MinIO ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# === Email / SMTP ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=ipm-flow@example.com
SMTP_FROM_NAME=IPM Flow
SMTP_USE_TLS=true

# === Docker compose frontend/API routing ===
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# VM deployment example:
# NEXT_PUBLIC_API_URL=http://20.86.26.141:8000
# CORS_ORIGINS=["http://20.86.26.141:3000"]
